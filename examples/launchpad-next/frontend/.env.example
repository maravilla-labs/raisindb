# RaisinDB connection for the launchpad-next frontend.
# Copy to .env (or .env.local) and adjust. All variables are optional —
# the defaults below match a local dev server.

# WebSocket endpoint: ws(s)://host:port/sys/{tenant}/{repository}
VITE_RAISIN_WS_URL=ws://localhost:8081/sys/default/launchpad-next

# Tenant ID (must match the URL path segment)
VITE_RAISIN_TENANT=default

# Repository name (must match the URL path segment)
VITE_RAISIN_REPO=launchpad-next

# Content workspace used for pages/assets
VITE_RAISIN_WORKSPACE=launchpad
