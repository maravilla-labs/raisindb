# Build output. `main.wasm` is generated by `raisindb function build` (see
# `make wasm-sdks-build`), never edited by hand.
#
# greet-rust's artifact IS committed — it is ~180 KB and makes the Rust half of
# the demo runnable from a fresh clone. The TinyGo (~2 MB) and jco (~12 MB)
# artifacts are not: a StarlingMonkey engine per artifact does not belong in
# git history. `smoke.mjs` says exactly how to build the ones that are missing.
content/functions/lib/demo/greet-go/main.wasm
content/functions/lib/demo/greet-ts/main.wasm
wasm/demo/*/main.wasm

# Toolchain scratch
target/
node_modules/

# `raisindb deploy` writes the .rap next to the caller; the CLI credentials
# file is per-machine.
*.rap
.raisinrc
